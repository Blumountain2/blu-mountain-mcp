# HubSpot MCP Server Environment Configuration Template
# Copy this file to .env and fill in your actual values. Never commit .env.

# ====================================
# Service Configuration
# ====================================

# Mode: development, staging, production
GATEWAY_MODE=development

# Log Level: debug, info, warning, error, critical
LOG_LEVEL=info

# Host-side port the service is exposed on
GATEWAY_PORT=8888

# ====================================
# HubSpot OAuth Configuration
# ====================================

# From the HubSpot Public App, registered via the HubSpot CLI's Developer
# Projects framework (`hs project create`/`hs project upload`) — legacy
# public-app creation through developers.hubspot.com's UI is disabled. Used
# for the Flow B install (client portal -> our vault) and the CRM OAuth v3 flow.
HUBSPOT_APP_CLIENT_ID=your-hubspot-app-client-id
HUBSPOT_APP_CLIENT_SECRET=your-hubspot-app-client-secret

# Must match the redirect URI configured on the HubSpot app exactly
HUBSPOT_REDIRECT_URI=http://localhost:8888/callback

# Space-separated scopes requested at install. All read-only — no write
# scope, ever (CLAUDE.md non-negotiable). Since the REST pivot
# (openspec/changes/hubspot-rest-api-pivot), this Public App token is the
# only credential HubSpotDataPullClient ever uses — there's no per-call
# read-verb allowlist gating what it can reach the way MCP's dynamic tool
# discovery had; this scope list is the actual and only enforcement point
# for what the Public App's token can do. Expanded beyond the original
# core-CRM-only grant to cover every REST endpoint family this project
# calls: content (CMS landing pages/blog posts, marketing email
# statistics), crm.lists.read (segments), crm.objects.owners.read
# (owners), settings.users.read (plain user list, account-info),
# settings.users.teams.read (the /settings/v3/users/teams endpoint
# specifically — confirmed live that settings.users.read alone does NOT
# cover it, a distinct 403 from every other endpoint despite the scope
# being granted), business-intelligence (content analytics), oauth
# (account-info, part of organization_details). Confirmed via HubSpot's
# own API reference docs and real live install/pull attempts, not assumed
# — see openspec/changes/hubspot-rest-api-pivot's task notes. A scope
# added here only takes effect for a tenant after that tenant
# re-completes /install — an existing vaulted token does not retroactively
# gain new scopes.
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read tickets content crm.lists.read crm.objects.owners.read settings.users.read settings.users.teams.read business-intelligence oauth

# Space-separated scopes requested via HubSpot's separate `optional_scope`
# authorize param, not `scope` — a portal that lacks one of these (e.g. no
# Marketing Hub Professional+) just has it silently omitted from the
# grant, instead of hard-failing the whole install the way a missing
# `scope` entry does. Confirmed live: requesting marketing.campaigns.read
# as a required scope broke real installs on both this project's test
# portals with "your account lacks access to the required scopes" —
# moved here instead. campaign_attribution/CAMPAIGN pulls degrade
# gracefully (pull_failed for that one object/capability, not a crash)
# on a portal that didn't get this scope granted. Also here:
# crm.objects.line_items.read, sales-email-read (LINE_ITEM/EMAIL CRM
# objects — distinct from the `content` scope, which only covers
# marketing email statistics, not the CRM email engagement object), and
# crm.objects.users.read (the CRM Users object type, distinct from
# settings.users.read's Settings User Provisioning API), crm.objects.quotes.read
# (QUOTE), crm.schemas.custom.read/crm.objects.custom.read (custom object
# schemas/records, openspec/changes/custom-object-support), and
# crm.objects.products.read (the Products object) are all here for the
# same reason as marketing.campaigns.read: a portal that lacks the
# underlying feature/tier just has the scope silently omitted, not a
# hard-fail. All of these are now CONFIRMED grantable and granted on both
# test portals (2026-09-03) — an earlier round of investigation wrongly
# attributed their initial no-grant to a HubSpot "sensitive scopes"
# Ecosystem Quality review, Enterprise-tier gating, and installer Super
# Admin status. The real cause was portal-side: HubSpot's Connected Apps
# admin settings have a per-scope data-permissions toggle that a portal
# admin must explicitly enable before that scope is even selectable on the
# OAuth consent screen, AND the consent screen itself serves a stale
# permission set in a reused browser tab — a fresh incognito session after
# enabling the toggle granted everything immediately. See CLAUDE.md for
# the full account. The legacy e-commerce master scope (Ecommerce
# Bridge/Shopify-style connector) was tried alongside products.read in an
# earlier build, then removed once products.read was confirmed to work on
# its own — not needed here.
HUBSPOT_OPTIONAL_SCOPES=marketing.campaigns.read crm.objects.line_items.read sales-email-read crm.objects.users.read crm.objects.quotes.read crm.schemas.custom.read crm.objects.custom.read crm.objects.products.read

# How long an in-flight PKCE state (between /install and /callback) stays valid.
OAUTH_STATE_TTL_MINUTES=10

# ====================================
# Live Interactive Session (FastMCP OAuth Proxy wrapping Google Workspace)
# ====================================

# Google Cloud OAuth 2.0 client for the live session. Distinct from
# GOOGLE_CLIENT_ID below, which belongs to a separate, unrelated auth path.
FASTMCP_GOOGLE_CLIENT_ID=
FASTMCP_GOOGLE_CLIENT_SECRET=

# Must include the /mcp mount prefix (main.py mounts this app there) —
# without it, every URL FastMCP advertises 404s for real clients.
FASTMCP_BASE_URL=http://localhost:8888/mcp

# Redirect URI registered on that OAuth client. Distinct from HUBSPOT_REDIRECT_URI.
FASTMCP_OAUTH_REDIRECT_URI=http://localhost:8888/mcp/auth/callback

# Comma-separated Workspace domains allowed to sign in; anything else is rejected
FASTMCP_ALLOWED_GOOGLE_DOMAINS=

# Access token lifetime in minutes (15-60 typical); the real revocation window
FASTMCP_ACCESS_TOKEN_TTL_MINUTES=30

# ====================================
# Direct Google/Microsoft Staff Auth — NOT currently configured
#
# gateway/session/staff_auth.py (a plain bearer-token JWT verifier, not an
# MCP server) is kept in the codebase but unhooked from main.py — see
# CLAUDE.md. It isn't imported by anything that runs today, so its four
# variables (GOOGLE_CLIENT_ID, GOOGLE_HOSTED_DOMAIN, MICROSOFT_CLIENT_ID,
# MICROSOFT_TENANT_ID — read directly via os.getenv, not config.settings)
# are deliberately left out of this file and out of docker-compose.yml's
# environment block, to avoid an unset-variable warning on every
# `docker compose` invocation for something nothing currently reads.
#
# If a future non-MCP consumer (e.g. a web dashboard) needs staff_auth.py:
# add GOOGLE_CLIENT_ID/GOOGLE_HOSTED_DOMAIN/MICROSOFT_CLIENT_ID/
# MICROSOFT_TENANT_ID back here (no client secret needed for either
# provider — this path only verifies already-issued JWTs) and back into
# docker-compose.yml's mcp-gateway environment block.
# ====================================

# ====================================
# Postgres (token vault, cache, locks, rate limiting, audit log)
# ====================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mcp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mcp
DATABASE_URL=postgresql://mcp:change-me@postgres:5432/mcp

# ====================================
# Token Encryption
# ====================================

# Encrypts stored HubSpot tokens at rest (AES-256). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# ====================================
# Rate Limiting
# ====================================

# Per-tenant requests allowed per minute (Postgres token-bucket)
RATE_LIMIT_PER_MINUTE=100

# ====================================
# Audit Logging
# ====================================

# Minimum retention required by the spec is 60 days
AUDIT_RETENTION_DAYS=60

# ====================================
# Airtable Staging
# ====================================

# Service account email (base collaborator, Creator role) — not a
# credential itself, just identifies whose token AIRTABLE_API_KEY is.
AIRTABLE_SERVICE_ACCOUNT=

# PAT from that service account: data.records:read/write, schema.bases:read/write,
# restricted to the staging base only
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# How often the HubSpot to Airtable staging cycle runs, in minutes
SYNC_INTERVAL_MINUTES=60

# ====================================
# Sybill Webhook Ingestion
# ====================================

# Signing secret for incoming webhooks (Svix HMAC). Despite the name, this
# is a secret, not a URL.
SYBILL_WEBHOOK=

# ====================================
# Vertical Pull Agent (openspec/changes/analysis-model-templates)
# ====================================

# One shared credential for the vertical pull agent (Claude API tool-use,
# not a trained/fine-tuned model) — never a per-client credential. The
# agent decides which of the existing allowlisted HubSpot pull methods to
# call per vertical; it gathers data, it never analyzes it. See
# design.md's Non-Negotiables in that change for the full boundary.
ANTHROPIC_API_KEY=

# ====================================
# Debug HubSpot Data API (gateway/debug_api.py)
# ====================================

# Gates every /debug/hubspot/* request (X-Debug-Api-Key header must match
# exactly) — a plain HTTP surface for pulling a real installed tenant's
# HubSpot data directly, for manual testing via Postman rather than through
# the MCP protocol (which Postman can't represent naturally). Empty = every
# request 401s, fail-closed, the same posture as an empty
# FASTMCP_ALLOWED_GOOGLE_DOMAINS. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEBUG_API_KEY=
